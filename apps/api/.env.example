# Local PostgreSQL (a default Homebrew/Postgres.app install uses your OS user, no password)
DATABASE_URL=postgres://localhost:5432/sarh_orders
# Wiped and re-seeded by `pnpm test`; created automatically if it does not exist.
TEST_DATABASE_URL=postgres://localhost:5432/sarh_orders_test

# With the optional docker-compose.yml instead:
# DATABASE_URL=postgres://sarh:sarh@localhost:5432/sarh_orders
# TEST_DATABASE_URL=postgres://sarh:sarh@localhost:5432/sarh_orders_test

PORT=3001

# Signs session tokens. Fine for local use; the API refuses to start with this value when
# NODE_ENV=production. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-me-before-deploying-anywhere
